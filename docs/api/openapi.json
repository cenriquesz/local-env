                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/apps": {
            "get": {
                "tags": [
                    "apps"
                ],
                "summary": "Listar apps externas",
                "description": "Detecta apps externas escaneando los .conf de nginx que no son del core de local-env.",
                "operationId": "get_apps_api_apps_get",
                "responses": {
                    "200": {
