                "description": "Lista las tablas del esquema `public` y su numero de filas, ejecutando `psql` dentro del\npropio contenedor de Postgres (credenciales leidas de su entorno real, no de un .env).",
                "operationId": "get_postgres_tables_api_postgres_tables_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
