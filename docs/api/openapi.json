            "get": {
                "tags": [
                    "aws"
                ],
                "summary": "Servicios AWS de LocalStack: endpoint, estado y recursos creados",
                "description": "Una tarjeta por servicio AWS emulado (S3, SQS, SES, STS, OpenSearch), con su endpoint, si esta\nactivo o solo disponible bajo demanda, y sus recursos ya creados (buckets, colas) con su ARN\npara los servicios donde eso aplica.",
                "operationId": "get_localstack_services_api_localstack_services_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
