{
    "openapi": "3.1.0",
    "info": {
        "title": "local-env dashboard",
        "description": "API del dashboard de local-env: estado de servicios, apps externas, certificados TLS y control basico del entorno.",
        "version": "1.2.0"
    },
    "paths": {
        "/api/services": {
            "get": {
                "tags": [
                    "servicios"
                ],
                "summary": "Listar servicios opcionales y su estado",
                "description": "Devuelve cada servicio opcional (OpenSearch, LocalStack, ActiveMQ, Kafka, Postgres) con el estado de sus contenedores y sus URLs.",
                "operationId": "get_services_api_services_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/service-categories": {
            "get": {
                "tags": [
                    "servicios"
                ],
                "summary": "Categorias para agrupar servicios",
                "description": "Orden y etiquetas de las categorias usadas para agrupar servicios en la UI (sidebar y vista Servicios).",
                "operationId": "get_service_categories_api_service_categories_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/health": {
            "get": {
                "tags": [
                    "salud"
                ],
                "summary": "Salud agregada de local-env (core + servicios opcionales)",
                "description": "Vista de una sola llamada para que apps externas comprueben, antes de arrancar, que local-env\nesta disponible y que servicios opcionales (Kafka, OpenSearch, LocalStack...) tienen arrancados.\n\n`status` es \"healthy\" si todo el core esta sano (running, o idle para minica tras generar los\ncerts), \"degraded\" si algo del core esta parcial, parado o en error, y no tiene en cuenta el\nestado de los servicios opcionales (son opcionales por definicion).",
                "operationId": "get_health_api_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/api/services/{service_id}/start": {
            "post": {
                "tags": [
                    "servicios"
                ],
                "summary": "Arrancar un servicio opcional",
                "description": "Sincroniza la config de nginx del servicio, levanta sus contenedores con docker compose y recarga nginx.",
                "operationId": "start_service_api_services__service_id__start_post",
                "parameters": [
                    {
                        "name": "service_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Service Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/services/{service_id}/stop": {
            "post": {
                "tags": [
                    "servicios"
                ],
                "summary": "Parar un servicio opcional",
                "description": "Detiene los contenedores del servicio y retira su config de nginx.",
                "operationId": "stop_service_api_services__service_id__stop_post",
                "parameters": [
                    {
                        "name": "service_id",
                        "in": "path",
                        "required": true,
